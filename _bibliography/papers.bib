@Article{Prihatno_2023_AplSci,
  AUTHOR = {Prihatno, Aji Teguh and Suryanto, Naufal and Oh, Sangbong and Le, Thi-Thu-Huong and Kim, Howon},
  TITLE = {NFT Image Plagiarism Check Using EfficientNet-Based Deep Neural Network with Triplet Semi-Hard Loss},
